.env.example
# Docker Model Runner Configuration
AI_PROVIDER=dmr
DMR_MODEL_NAME=ai/smollm2
DMR_CONTEXT_SIZE=4096

# Alternative Cloud Providers (set AI_PROVIDER to 'anthropic' or 'openai' to use)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Database
DB_PASSWORD=operon_password

# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Background Worker
MAX_CONCURRENT_JOBS=3
JOB_TIMEOUT_SECONDS=300
JOB_RETRY_ATTEMPTS=3
